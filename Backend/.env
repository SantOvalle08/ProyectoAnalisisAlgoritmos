# Configuracion de la aplicacion
APP_NAME="Analisis Bibliometrico API"
DEBUG=true
VERSION="1.0.0"

# Configuracion del servidor
HOST="127.0.0.1"
PORT=8000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/bibliometric_analysis"
DATABASE_USER="postgres"
DATABASE_PASSWORD="password"
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="bibliometric_analysis"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# Autenticacion
SECRET_KEY="your-secret-key-change-in-production-this-should-be-very-long-and-random"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# APIs externas
CROSSREF_API_EMAIL="santiago.ovalle@uniquindio.edu.co"
ELSEVIER_API_KEY="ebffb30f5cb764d516cb320d5762363e"

# Credenciales para scrapers con autenticacion
ACM_USERNAME=""
ACM_PASSWORD=""

# SAGE Publications
SAGE_USERNAME=""
SAGE_PASSWORD=""
SAGE_INSTITUTIONAL_URL="https://search-sagepub-com.crai.referencistas.com/"

# IEEE Xplore (futuro)
IEEE_USERNAME=""
IEEE_PASSWORD=""

# Configuracion de Selenium/ChromeDriver
SELENIUM_HEADLESS=false
SELENIUM_IMPLICIT_WAIT=10
SELENIUM_PAGE_LOAD_TIMEOUT=30
CHROMEDRIVER_PATH=""

# Modelos ML/NLP
MODEL_CACHE_DIR="./models"
DEFAULT_SENTENCE_MODEL="all-MiniLM-L6-v2"
SPACY_MODEL="en_core_web_sm"

# Logging
LOG_LEVEL="INFO"
LOG_FILE="app.log"

# Limites
MAX_FILE_SIZE=10485760
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Configuracion especifica del proyecto
SEARCH_QUERY="generative artificial intelligence"
MAX_RESULTS_PER_SOURCE=1000